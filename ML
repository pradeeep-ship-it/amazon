_prefix_idx)\n    )\n\n    combined_candidates = base_candidates | prefix_candidates\n\n    base_hits += len(truth & base_candidates)\n    new_hits += len(truth & combined_candidates)\n\n    recovered = len(\n        truth &\n        prefix_candidates -\n        base_candidates\n    )\n\n    new_recovered_pairs += recovered\n\n    base_candidate_counts.append(len(base_candidates))\n    new_candidate_counts.append(len(combined_candidates))\n\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"STEP 3 — NAME PREFIX RESULTS\")\nprint(\"=\" * 70)\n\nprint(f\"Baseline recall:        {base_hits / total:.6%}\")\nprint(f\"New recall:             {new_hits / total:.6%}\")\nprint(f\"New pairs recovered:    {new_recovered_pairs:,}\")\n\nprint()\nprint(\n    f\"Average candidates:     \"\n    f\"{np.mean(base_candidate_counts):.1f} -> \"\n    f\"{np.mean(new_candidate_counts):.1f}\"\n)\n\nprint(\n    f\"95th percentile:        \"\n    f\"{np.percentile(base_candidate_counts, 95):.1f} -> \"\n    f\"{np.percentile(new_candidate_counts, 95):.1f}\"\n)\n\nprint(\n    f\"Maximum candidates:     \"\n    f\"{max(base_candidate_counts):,} -> \"\n    f\"{max(new_candidate_counts):,}\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-26T23:43:08.60672Z","iopub.execute_input":"2026-09-26T23:43:08.60722Z","iopub.status.idle":"2026-09-26T23:44:17.974458Z","shell.execute_reply.started":"2026-09-26T23:43:08.607187Z","shell.execute_reply":"2026-09-26T23:44:17.973456Z"}},"outputs":[{"name":"stdout","text":"======================================================================\nBUILDING TARGETED NAME-PREFIX INDEXES\n======================================================================\nS2 prefix keys: 4,125,113\nS3 prefix keys: 4,413,940\n\n======================================================================\nSTEP 3 — NAME PREFIX RESULTS\n======================================================================\nBaseline recall:        97.047833%\nNew recall:             97.746349%\nNe