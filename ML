on\n# ------------------------------------------------------------\n\ndef rare_address_trigrams(address, topk=4):\n    if not isinstance(address, str) or not address:\n        return []\n\n    trigrams = address_char_trigrams(address)\n\n    return sorted(\n        trigrams,\n        key=lambda x: address_trigram_df.get(x, 0),\n    )[:topk]\n\n\n# ------------------------------------------------------------\n# Build indexes\n# ------------------------------------------------------------\n\ndef build_address_trigram_index(df):\n    index = defaultdict(list)\n\n    for entity_id, address in zip(\n        df[\"entity_id\"].values,\n        df[\"na\"].values,\n    ):\n\n        for trigram in rare_address_trigrams(address, topk=4):\n\n            postings = index[trigram]\n\n            if len(postings) < MAX_ADDRESS_TRIGRAM_POSTINGS:\n                postings.append(entity_id)\n\n    return dict(index)\n\n\nprint(\"\\nBuilding S2 address-trigram index...\")\ns2_address_trigram_idx = build_address_trigram_index(s2_target)\n\nprint(\"Building S3 address-trigram index...\")\ns3_address_trigram_idx = build_address_trigram_index(s3_target)\n\nprint(\n    f\"\\nS2 index keys: {len(s2_address_trigram_idx):,}\"\n)\n\nprint(\n    f\"S3 index keys: {len(s3_address_trigram_idx):,}\"\n)\n\n\ndef address_trigram_candidates(address, index):\n    candidates = set()\n\n    for trigram in rare_address_trigrams(address, topk=4):\n        candidates.update(index.get(trigram, []))\n\n    return candidates\n\n\n# ------------------------------------------------------------\n# Evaluate against CURRENT baseline\n# ------------------------------------------------------------\n\nbase_hits = 0\nnew_hits = 0\n\nbase_candidate_counts = []\nnew_candidate_counts = []\n\nnew_recovered_pairs = 0\n\n\nfor row in validation_s1.itertuples(index=False):\n\n    values = row._asdict()\n\n    truth = validation_truth.get(\n        row.entity_id,\n        set(),\n    )\n\n    # CURRENT BEST BASELINE\n    # I