rror(\n        f\"S3 normalized table must contain {required_norm}. \"\n        f\"Found: {list(s3_norm.columns)}\"\n    )\n\n# ------------------------------------------------------------\n# 6. IMPORTANT:\n# Build entity_id -> ROW POSITION mapping using pandas index\n# rather than storing complete target dictionaries.\n#\n# We only create mappings if entity_id is not already the index.\n# ------------------------------------------------------------\n\nprint()\nprint(\"Preparing lightweight row-position access...\")\n\ns2_entity_to_pos = pd.Series(\n    np.arange(len(s2_norm), dtype=np.int32),\n    index=s2_norm[\"entity_id\"].values\n)\n\ns3_entity_to_pos = pd.Series(\n    np.arange(len(s3_norm), dtype=np.int32),\n    index=s3_norm[\"entity_id\"].values\n)\n\nprint(f\"S2 row-position map: {len(s2_entity_to_pos):,}\")\nprint(f\"S3 row-position map: {len(s3_entity_to_pos):,}\")\n\nprint(f\"RAM after row maps: {ram_gib():.2f} GiB\")\n\n# ------------------------------------------------------------\n# 7. GET GROUND TRUTH\n# ------------------------------------------------------------\n\nif \"validation_truth\" not in globals():\n\n    if \"ground_truth\" in globals():\n\n        validation_truth = {}\n\n        for row in ground_truth.itertuples(index=False):\n            validation_truth.setdefault(row.s1_entity_id, set()).add(\n                row.target_entity_id\n            )\n\n    else:\n        raise RuntimeError(\n            \"validation_truth / ground_truth is missing. \"\n            \"Do not continue.\"\n        )\n\nprint(f\"Validation truth entities: {len(validation_truth):,}\")\n\n# ------------------------------------------------------------\n# 8. BLOCKING FUNCTION\n# ------------------------------------------------------------\n#\n# We deliberately use only indexes that are currently present.\n#\n# No new massive index is created here.\n# ------------------------------------------------------------\n\ndef get_candidates_for_s1(row):\n\n    candidates 