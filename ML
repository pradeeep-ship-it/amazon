-------------------------\n\nprint()\nprint(\"=\" * 70)\nprint(\"STARTING END-TO-END VALIDATION\")\nprint(\"=\" * 70)\n\nstart_time = time.time()\n\nresults = []\n\ntotal = len(validation_s1)\n\n# VERY IMPORTANT:\n# Small chunks keep temporary objects bounded.\nCHUNK_SIZE = 250\n\nfor start in range(0, total, CHUNK_SIZE):\n\n    end = min(start + CHUNK_SIZE, total)\n\n    chunk = validation_s1.iloc[start:end]\n\n    for row in chunk.itertuples(index=False):\n\n        try:\n            outputs = score_validation_entity(row)\n\n            if outputs:\n                results.extend(outputs)\n\n        except Exception as e:\n\n            print(\n                f\"WARNING: entity {row.entity_id} failed: {e}\"\n            )\n\n    # ----------------------------------------\n    # Cleanup after EVERY chunk\n    # ----------------------------------------\n\n    del chunk\n    gc.collect()\n\n    elapsed = (time.time() - start_time) / 60\n\n    print(\n        f\"Processed: {end:6d} / {total:,} | \"\n        f\"Predicted pairs: {len(results):7,} | \"\n        f\"Time: {elapsed:6.1f} min | \"\n        f\"RAM: {ram_gib():.2f} GiB\"\n    )\n\n    # ----------------------------------------\n    # Emergency RAM guard\n    # ----------------------------------------\n\n    if ram_gib() > 27.5:\n\n        print()\n        print(\"!!! RAM SAFETY STOP !!!\")\n        print(f\"RAM reached {ram_gib():.2f} GiB\")\n        print(\"Saving partial validation results...\")\n\n        pd.DataFrame(\n            results,\n            columns=[\n                \"s1_entity_id\",\n                \"target_entity_id\",\n                \"probability\",\n                \"source\"\n            ]\n        ).to_pickle(\n            \"/kaggle/working/step24_partial_results.pkl\"\n        )\n\n        raise MemoryError(\n            \"Stopped safely before Kaggle RAM limit. \"\n            \"Partial results saved.\"\n        )\n\n\n# ------------------------------------------------------------\