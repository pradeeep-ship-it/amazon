1 = s1_match.iloc[0]\n    target = target_match.iloc[0]\n\n    score, shared_count = selective_containment(\n        s1[\"na\"],\n        target[\"na\"]\n    )\n\n    results.append({\n        \"s1_entity_id\": s1_id,\n        \"target_entity_id\": target_id,\n        \"score\": score,\n        \"shared_tokens\": shared_count,\n        \"s1_address\": s1[\"na\"],\n        \"target_address\": target[\"na\"],\n    })\n\n\nselective_df = pd.DataFrame(results)\n\n\nprint(\"=\" * 70)\nprint(\"STEP 12 - SELECTIVE ADDRESS CONTAINMENT\")\nprint(\"=\" * 70)\n\nprint(\n    f\"Residual pairs analyzed: \"\n    f\"{len(selective_df):,}\"\n)\n\nprint()\n\n# Different thresholds\nfor score_threshold in [\n    1.00,\n    0.80,\n    0.67,\n    0.50,\n]:\n\n    mask = (\n        (selective_df[\"score\"] >= score_threshold)\n        &\n        (selective_df[\"shared_tokens\"] >= 2)\n    )\n\n    print(\n        f\"Score >= {score_threshold:.2f} \"\n        f\"AND shared tokens >= 2: \"\n        f\"{mask.sum():,} pairs\"\n    )\n\n\nprint()\nprint(\"=\" * 70)\nprint(\"EXACT SELECTIVE MATCHES\")\nprint(\"=\" * 70)\n\ndisplay(\n    selective_df[\n        (selective_df[\"score\"] >= 1.0)\n        &\n        (selective_df[\"shared_tokens\"] >= 2)\n    ]\n    .sort_values(\n        [\"shared_tokens\", \"score\"],\n        ascending=False\n    )\n    .head(30)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-27T00:04:23.577801Z","iopub.execute_input":"2026-09-27T00:04:23.578489Z","iopub.status.idle":"2026-09-27T00:04:24.95318Z","shell.execute_reply.started":"2026-09-27T00:04:23.578456Z","shell.execute_reply":"2026-09-27T00:04:24.952405Z"}},"outputs":[{"name":"stdout","text":"======================================================================\nSTEP 12 - SELECTIVE ADDRESS CONTAINMENT\n======================================================================\nResidual pairs analyzed: 681\n\nScore >= 1.00 AND shared tokens >= 2: 95 pairs\nScore >= 0.80 AND shared tokens >